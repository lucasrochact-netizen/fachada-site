---
// Componente fixo (sticky) — WhatsApp e Voltar ao topo. (§5 do TASK)
import { whatsappUrl } from "../lib/whatsapp.ts";
const stickyHref = whatsappUrl("whatsapp_sticky");
---

<div class="floaters" data-floaters>
  <a
    class="floater floater--whatsapp"
    href={stickyHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Falar no WhatsApp"
    data-floater-whatsapp
  >
    <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/>
    </svg>
  </a>

  <button
    class="floater floater--top"
    type="button"
    aria-label="Voltar ao topo"
    data-floater-top
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 16V4M4 10l6-6 6 6"/>
    </svg>
  </button>
</div>

<style>
  .floaters {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.85rem;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .floaters {
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }

  .floater {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    box-shadow: 0 8px 24px -8px rgba(26, 22, 20, 0.35);
    transition:
      transform 0.45s var(--ease-praca),
      box-shadow 0.45s var(--ease-praca),
      opacity 0.4s var(--ease-praca),
      background-color 0.4s var(--ease-praca);
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }
  .floater.is-visible {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  .floater:hover {
    transform: scale(1.06);
    box-shadow: 0 12px 32px -8px rgba(26, 22, 20, 0.45);
  }

  /* WhatsApp */
  .floater--whatsapp {
    width: 56px;
    height: 56px;
    background-color: #25D366;
    color: #FBF8F2;
    border: 0;
    text-decoration: none;
  }
  .floater--whatsapp:hover { background-color: #20bd5b; }

  /* Voltar ao topo */
  .floater--top {
    width: 44px;
    height: 44px;
    background-color: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-line-strong);
    cursor: pointer;
  }
  .floater--top:hover {
    background-color: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .floater { transition: opacity 0.2s; transform: none; }
  }
</style>

<script>
  import { springIn } from "../lib/motion.ts";

  const wa = document.querySelector<HTMLAnchorElement>("[data-floater-whatsapp]");
  const top = document.querySelector<HTMLButtonElement>("[data-floater-top]");

  let waShown = false;
  let topShown = false;

  function update() {
    const y = window.scrollY;
    if (!waShown && y > 600 && wa) {
      waShown = true;
      wa.classList.add("is-visible");
      try { springIn(wa); } catch { /* fallback CSS handles it */ }
    }
    if (!topShown && y > 1500 && top) {
      topShown = true;
      top.classList.add("is-visible");
      try { springIn(top); } catch { /* */ }
    }
    // Esconde voltar-ao-topo se voltar pra perto do topo
    if (top) {
      if (y < 800) top.classList.remove("is-visible");
      else if (y >= 1500) top.classList.add("is-visible");
    }
  }

  top?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  // Observa scroll com throttle leve
  let raf = 0;
  window.addEventListener("scroll", () => {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      raf = 0;
      update();
    });
  }, { passive: true });
  update();
</script>
