---
// Mockup do "antes" — visual deliberadamente datado/feio pra contrastar com o "depois".
// Duas variantes:
//  - tipo="cardapio": PDF antigo amassado (Times Roman, sem fotos, lista chata)
//  - tipo="site":     site de 2018 (header azul cyan, "Bem-vindo!", clip art, contador de visitas)
//
// Usado em conjunto com MockupSite/MockupCardapio (depois) na galeria.

interface Props {
  tipo?: "cardapio" | "site";
  nome?: string;
}
const { tipo = "cardapio", nome = "Seu Negócio" } = Astro.props;
---

{tipo === "cardapio" ? (
  <!-- ANTES: PDF de cardápio amassado, sem foto, Times Roman -->
  <svg
    class="mockup-svg"
    viewBox="0 0 320 100"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`Mockup do cardápio antigo de ${nome}, em PDF`}
    preserveAspectRatio="xMidYMid meet"
  >
    <!-- Fundo cinza/sombra -->
    <rect width="320" height="100" fill="#cbc5b3"/>

    <!-- Folha de papel branca amarelada (com leve rotação que sugere amassada) -->
    <g transform="translate(160, 50) rotate(-1.5) translate(-130, -42)">
      <!-- Sombra -->
      <rect x="2" y="2" width="260" height="84" fill="#928c7d" opacity="0.4"/>
      <!-- Papel -->
      <rect width="260" height="84" fill="#f5edd3"/>
      <!-- "Vincos" sutis -->
      <line x1="0" y1="42" x2="260" y2="40" stroke="rgba(0,0,0,0.05)" stroke-width="0.5"/>
      <line x1="130" y1="0" x2="132" y2="84" stroke="rgba(0,0,0,0.04)" stroke-width="0.5"/>

      <!-- Título "CARDÁPIO" Times Roman -->
      <text x="130" y="14" text-anchor="middle" font-family="'Times New Roman', Times, serif" font-size="9" font-weight="700" fill="#1A1614" letter-spacing="2">CARDÁPIO</text>
      <line x1="100" y1="17" x2="160" y2="17" stroke="#1A1614" stroke-width="0.4"/>

      <!-- Lista chata de itens com preço pontilhado -->
      <g font-family="'Times New Roman', Times, serif" font-size="6" fill="#1A1614">
        <text x="14" y="30">Prato 1 da casa</text>
        <text x="246" y="30" text-anchor="end">R$ 28,00</text>
        <line x1="74" y1="29" x2="220" y2="29" stroke="#888" stroke-width="0.3" stroke-dasharray="1 1"/>

        <text x="14" y="40">Prato 2 da casa</text>
        <text x="246" y="40" text-anchor="end">R$ 32,00</text>
        <line x1="74" y1="39" x2="220" y2="39" stroke="#888" stroke-width="0.3" stroke-dasharray="1 1"/>

        <text x="14" y="50">Especial do chef</text>
        <text x="246" y="50" text-anchor="end">R$ 38,00</text>
        <line x1="78" y1="49" x2="220" y2="49" stroke="#888" stroke-width="0.3" stroke-dasharray="1 1"/>

        <text x="14" y="60">Sobremesa caseira</text>
        <text x="246" y="60" text-anchor="end">R$ 18,00</text>
        <line x1="80" y1="59" x2="220" y2="59" stroke="#888" stroke-width="0.3" stroke-dasharray="1 1"/>

        <text x="14" y="70">Refrigerante</text>
        <text x="246" y="70" text-anchor="end">R$ 8,00</text>
        <line x1="60" y1="69" x2="220" y2="69" stroke="#888" stroke-width="0.3" stroke-dasharray="1 1"/>
      </g>

      <!-- Rodapé "obrigado!" -->
      <text x="130" y="80" text-anchor="middle" font-family="'Times New Roman', Times, serif" font-size="5" font-style="italic" fill="#4A4340">Obrigado pela preferência!</text>
    </g>

    <!-- Carimbo "PDF" -->
    <g transform="translate(284, 18) rotate(8)">
      <rect width="28" height="14" rx="1" fill="none" stroke="#B5563A" stroke-width="0.8"/>
      <text x="14" y="10" text-anchor="middle" font-family="ui-monospace, monospace" font-size="6" font-weight="700" fill="#B5563A" letter-spacing="0.5">PDF</text>
    </g>
  </svg>
) : (
  <!-- ANTES: Site de 2018 (lift do navegador antigo, Times, "Bem-vindo!") -->
  <svg
    class="mockup-svg"
    viewBox="0 0 320 100"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`Mockup do site antigo de ${nome}`}
    preserveAspectRatio="xMidYMid meet"
  >
    <!-- Fundo cinza -->
    <rect width="320" height="100" fill="#cbc5b3"/>

    <!-- "Browser" antigo IE-style -->
    <rect x="14" y="8" width="292" height="84" fill="#FFFFFF" stroke="#888" stroke-width="0.8"/>
    <!-- Top bar IE/Netscape style -->
    <rect x="14" y="8" width="292" height="14" fill="#cfd8dc"/>
    <rect x="280" y="11" width="8" height="8" fill="#888"/>
    <rect x="290" y="11" width="8" height="8" fill="#888"/>
    <rect x="300" y="11" width="6" height="8" fill="#B5563A"/>
    <text x="22" y="18" font-family="'Times New Roman', Times, serif" font-size="6" fill="#1A1614">{nome}</text>
    <!-- Address bar -->
    <rect x="14" y="22" width="292" height="10" fill="#FFFFFF" stroke="#888" stroke-width="0.4"/>
    <text x="20" y="29" font-family="'Times New Roman', Times, serif" font-size="5.5" fill="#0033cc" text-decoration="underline">http://www.{nome.toLowerCase().replace(/[^a-z0-9]/g, "")}.com.br/index.html</text>

    <!-- Header azul cyan estilo "site de 2018" -->
    <rect x="14" y="32" width="292" height="20" fill="#1B6DC1"/>
    <text x="160" y="46" text-anchor="middle" font-family="'Times New Roman', Times, serif" font-size="11" font-weight="700" fill="#FFFFFF">Bem-vindo ao nosso site!</text>

    <!-- Conteúdo -->
    <text x="22" y="62" font-family="'Times New Roman', Times, serif" font-size="6" fill="#1A1614">Somos uma empresa séria com tradição no mercado.</text>
    <text x="22" y="70" font-family="'Times New Roman', Times, serif" font-size="6" fill="#1A1614">Para mais informações <tspan fill="#0033cc" text-decoration="underline">CLIQUE AQUI</tspan> ou ligue no telefone.</text>

    <!-- "Logo" placeholder horroroso -->
    <rect x="22" y="76" width="36" height="14" fill="none" stroke="#888" stroke-width="0.6" stroke-dasharray="2 1"/>
    <text x="40" y="85" text-anchor="middle" font-family="'Times New Roman', Times, serif" font-size="5" fill="#888">LOGO AQUI</text>

    <!-- Counter de visitas -->
    <rect x="64" y="76" width="60" height="14" fill="#000"/>
    <text x="68" y="85" font-family="ui-monospace, monospace" font-size="6" fill="#00FF00" letter-spacing="1">VISITAS: 0042</text>

    <!-- Marquee "VISITE NOSSAS REDES!!!" -->
    <rect x="130" y="76" width="172" height="14" fill="#FFFF00"/>
    <text x="134" y="85" font-family="'Times New Roman', Times, serif" font-size="6" font-weight="700" fill="#B5563A" font-style="italic">★ VISITE NOSSAS REDES SOCIAIS!!! ★</text>

    <!-- Atualizado em 2018 -->
    <text x="296" y="62" text-anchor="end" font-family="'Times New Roman', Times, serif" font-size="4.5" fill="#888" font-style="italic">Atualizado em 03/05/2018</text>
  </svg>
)}

<style>
  .mockup-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
