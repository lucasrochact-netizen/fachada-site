---
// Seção 5 — Como funciona em 3 passos. (§4.5 do TASK)
const passos = [
  {
    num: "01",
    titulo: "Você manda WhatsApp",
    desc: "Diz qual produto quer e o nome do seu negócio."
  },
  {
    num: "02",
    titulo: "A gente entrega em 5–7 dias",
    desc: "Você recebe o link, testa, dá feedback. Ajustes ilimitados nos primeiros 30 dias."
  },
  {
    num: "03",
    titulo: "Não gostou? Devolvo o dinheiro",
    desc: "Garantia de 7 dias após a entrega. Sem letra miúda, sem burocracia."
  }
];
---

<section id="como" class="como" aria-labelledby="como-title">
  <div class="praca-container">
    <p class="como__eyebrow reveal">Sem mistério</p>
    <h2 id="como-title" class="como__title reveal">Como funciona.</h2>

    <ol class="como__lista reveal-stagger">
      {passos.map((p, i) => (
        <li class="como__passo reveal">
          <span class="como__num" aria-hidden="true">{p.num}</span>
          <h3 class="como__passo-titulo">{p.titulo}</h3>
          <p class="como__passo-desc">{p.desc}</p>
          {i < passos.length - 1 && (
            <span class="como__linha" aria-hidden="true"></span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .como {
    background-color: var(--color-paper);
    padding-block: 5rem;
    position: relative;
  }
  @media (min-width: 768px) { .como { padding-block: 7rem; } }

  .como__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-clay);
    margin: 0 0 0.85rem 0;
  }
  .como__title {
    font-size: clamp(2rem, 5vw + 0.5rem, 3.5rem);
    margin: 0 0 3.5rem 0;
    letter-spacing: -0.02em;
  }

  .como__lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    counter-reset: passo;
  }
  @media (min-width: 768px) {
    .como__lista {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .como__passo {
    position: relative;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .como__num {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 700;
    color: var(--color-clay-light);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 1rem;
    font-variation-settings: "opsz" 144;
  }

  .como__passo-titulo {
    font-size: clamp(1.25rem, 1.5vw + 0.5rem, 1.5rem);
    margin: 0 0 0.6rem 0;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 36;
  }

  .como__passo-desc {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 32ch;
  }

  /* Linha de progresso entre passos (desktop) */
  .como__linha {
    display: none;
  }
  @media (min-width: 768px) {
    .como__linha {
      display: block;
      position: absolute;
      top: -1px;
      right: -1.4rem;
      width: 1.4rem;
      height: 1px;
      background: linear-gradient(to right, var(--color-clay), transparent);
    }
  }
</style>

<script>
  import { initReveal } from "../lib/motion.ts";
  initReveal();
</script>
