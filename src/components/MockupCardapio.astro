---
// Mockup SVG inline de cardápio QR no celular — 3 variantes ricas por tipo.
// Princípios aplicados (research em restaurant website best practices 2026):
// - Cardápio HTML responsivo (não PDF)
// - Foto de cada prato com placeholder visual
// - Preço claro em mono
// - Categorias/abas no topo
// - CTA forte ao final ("Pedir agora" eleva conversão 83%)
// - Trust signals: estrelas, número de avaliações
// - Top sellers em destaque

interface Props {
  nome: string;
  cidade: string;
  paleta?: "clay" | "moss" | "ink";
  tipo?: "italiana" | "burger" | "padaria";
  itens?: Array<{ nome: string; preco: string; desc?: string }>;
  rating?: string;
}
const {
  nome,
  cidade,
  paleta = "clay",
  tipo = "italiana",
  itens,
  rating = "4.8"
} = Astro.props;

// Tema claro vs escuro (burger é dark mode)
const isDark = tipo === "burger" && paleta === "ink";

const colors = {
  clay: { bg: "#FBF8F2", surface: "#F4EFE6", accent: "#B5563A", accentDeep: "#8B3E29", accentSoft: "#D9A89A", text: "#1A1614", textSoft: "#4A4340", line: "rgba(26, 22, 20, 0.1)" },
  moss: { bg: "#F4EFE6", surface: "#E8E8DA", accent: "#5A6B4F", accentDeep: "#3a4632", accentSoft: "#a3b194", text: "#1A1614", textSoft: "#4A4340", line: "rgba(26, 22, 20, 0.1)" },
  ink:  { bg: "#1A1614", surface: "#26211D", accent: "#C9A961", accentDeep: "#a78a45", accentSoft: "#4A4340", text: "#F4EFE6", textSoft: "#a8a299", line: "rgba(244, 239, 230, 0.1)" }
}[paleta];

// Defaults por tipo se não passar itens
const itensDefault = {
  italiana: [
    { nome: "Margherita Búfala", preco: "58,00", desc: "Manjericão fresco · molho San Marzano" },
    { nome: "Tortelli Trufa Negra", preco: "92,00", desc: "Massa fresca · ricota di búfala" },
    { nome: "Lasanha Bolonhesa", preco: "72,00", desc: "Massa fresca · ragú 8 horas" }
  ],
  burger: [
    { nome: "Smash Duplo Cheddar", preco: "38,00", desc: "Pão brioche · maionese da casa" },
    { nome: "Trinta Bacon", preco: "42,00", desc: "Bacon caramelizado · cheddar inglês" },
    { nome: "Veggie Cogumelo", preco: "32,00", desc: "Hambúrguer de shimeji · molho tahine" }
  ],
  padaria: [
    { nome: "Croissant de Manteiga", preco: "12,00", desc: "Manteiga francesa · 72h de fermentação" },
    { nome: "Pão de Queijo Premium", preco: "4,50", desc: "Queijo canastra · feito na hora" },
    { nome: "Bolo Cenoura Chocolate", preco: "8,00", desc: "Chocolate belga · receita da casa" }
  ]
};
const lista = itens ?? itensDefault[tipo];

// Categoria principal por tipo
const categorias = {
  italiana: ["Massas", "Pizzas", "Risotos", "Bebidas"],
  burger:   ["Smashes", "Combos", "Acompanha", "Bebidas"],
  padaria:  ["Pães", "Doces", "Salgados", "Bebidas"]
}[tipo];

// CTA específico
const cta = {
  italiana: "Pedir no WhatsApp",
  burger:   "Pedir agora",
  padaria:  "Encomendar"
}[tipo];

// Cor do "destaque" tag por tipo
const destaqueLabel = {
  italiana: "DA CASA",
  burger:   "MAIS PEDIDO",
  padaria:  "ESPECIAL DO DIA"
}[tipo];
---

<svg
  class="mockup-svg"
  viewBox="0 0 320 400"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`Mockup do cardápio QR de ${nome}, em ${cidade}`}
  preserveAspectRatio="xMidYMid meet"
>
  <!-- Background -->
  <rect width="320" height="400" fill={paleta === "moss" ? "#dad9c8" : "#E8E0D2"}/>

  <!-- Telefone -->
  <rect x="64" y="14" width="192" height="372" rx="22" fill="#1A1614"/>
  <rect x="70" y="26" width="180" height="348" rx="16" fill={colors.bg}/>

  <!-- Notch -->
  <rect x="138" y="26" width="44" height="6" rx="3" fill="#1A1614"/>

  <!-- ====== HEADER ====== -->
  <text x="160" y="56" text-anchor="middle" font-family="Georgia, serif" font-size="11" font-weight="700" fill={colors.text} letter-spacing="-0.4">
    {nome}
  </text>
  <g transform="translate(160, 64)">
    <text text-anchor="middle" font-family="ui-monospace, monospace" font-size="5" fill={colors.textSoft} letter-spacing="0.5">{cidade.toUpperCase()}</text>
  </g>
  <!-- Rating row -->
  <g transform="translate(98, 70)">
    <text font-family="ui-monospace, monospace" font-size="5.5" fill="#C9A961">★★★★★</text>
    <text x="34" y="0" font-family="ui-monospace, monospace" font-size="5.5" font-weight="600" fill={colors.text}>{rating}</text>
    <text x="46" y="0" font-family="ui-sans-serif, system-ui" font-size="5" fill={colors.textSoft}>· 234 avaliações · aberto</text>
    <circle cx="124" cy="-2" r="2.5" fill="#5A6B4F"/>
  </g>

  <!-- Linha divisória -->
  <line x1="84" y1="80" x2="236" y2="80" stroke={colors.line} stroke-width="0.5"/>

  <!-- ====== CATEGORIA TABS ====== -->
  <g transform="translate(80, 88)">
    {categorias.map((c, i) => (
      <g transform={`translate(${i * 40}, 0)`}>
        {i === 0 ? (
          <>
            <rect x="0" y="0" width="36" height="14" rx="7" fill={colors.accent}/>
            <text x="18" y="10" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="5.5" font-weight="600" fill={colors.bg}>{c}</text>
          </>
        ) : (
          <>
            <rect x="0" y="0" width="36" height="14" rx="7" fill="none" stroke={colors.line} stroke-width="0.5"/>
            <text x="18" y="10" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="5.5" fill={colors.textSoft}>{c}</text>
          </>
        )}
      </g>
    ))}
  </g>

  <!-- ====== DESTAQUE: HERO ITEM ====== -->
  <g transform="translate(80, 110)">
    <rect width="160" height="80" rx="6" fill={colors.surface} stroke={colors.line} stroke-width="0.5"/>

    <!-- Photo placeholder -->
    {tipo === "italiana" && (
      <g transform="translate(8, 8)">
        <rect width="60" height="64" rx="4" fill={colors.accent}/>
        <!-- pizza simulation -->
        <circle cx="30" cy="32" r="22" fill={colors.accentSoft}/>
        <circle cx="22" cy="26" r="3" fill={colors.accentDeep}/>
        <circle cx="36" cy="24" r="2" fill={colors.accentDeep}/>
        <circle cx="38" cy="38" r="2.5" fill={colors.accentDeep}/>
        <circle cx="24" cy="38" r="2" fill={colors.accentDeep}/>
        <circle cx="28" cy="32" r="1.5" fill="#5A6B4F"/>
      </g>
    )}
    {tipo === "burger" && (
      <g transform="translate(8, 8)">
        <rect width="60" height="64" rx="4" fill={paleta === "ink" ? "#26211D" : colors.accent}/>
        <!-- burger silhouette -->
        <ellipse cx="30" cy="22" rx="22" ry="6" fill="#C9A961"/>
        <rect x="9" y="24" width="42" height="5" fill="#5A6B4F" opacity="0.7"/>
        <rect x="9" y="29" width="42" height="6" fill="#8B3E29"/>
        <rect x="9" y="35" width="42" height="3" fill="#C9A961" opacity="0.8"/>
        <ellipse cx="30" cy="44" rx="22" ry="8" fill="#C9A961"/>
        <!-- sesame -->
        <circle cx="20" cy="20" r="0.8" fill={colors.bg}/>
        <circle cx="30" cy="18" r="0.8" fill={colors.bg}/>
        <circle cx="40" cy="20" r="0.8" fill={colors.bg}/>
      </g>
    )}
    {tipo === "padaria" && (
      <g transform="translate(8, 8)">
        <rect width="60" height="64" rx="4" fill={colors.accentSoft}/>
        <!-- croissant -->
        <path d="M 12 38 Q 18 18 30 16 Q 42 18 48 38 Q 42 50 30 50 Q 18 50 12 38" fill={colors.accent}/>
        <path d="M 16 36 Q 22 24 30 24 Q 38 24 44 36" stroke={colors.accentDeep} stroke-width="1" fill="none"/>
        <path d="M 18 40 Q 25 32 30 32 Q 35 32 42 40" stroke={colors.accentDeep} stroke-width="1" fill="none"/>
      </g>
    )}

    <!-- Tag DESTAQUE -->
    <rect x="74" y="8" width="44" height="9" rx="2" fill={colors.accent}/>
    <text x="96" y="14.5" text-anchor="middle" font-family="ui-monospace, monospace" font-size="4.5" font-weight="600" fill={colors.bg} letter-spacing="0.5">{destaqueLabel}</text>

    <!-- Item info -->
    <text x="74" y="28" font-family="Georgia, serif" font-size="9" font-weight="700" fill={colors.text}>{lista[0].nome}</text>
    <text x="74" y="38" font-family="ui-sans-serif, system-ui" font-size="5.5" fill={colors.textSoft}>{lista[0].desc?.split(" · ")[0] ?? "Receita exclusiva"}</text>
    <text x="74" y="46" font-family="ui-sans-serif, system-ui" font-size="5.5" fill={colors.textSoft}>{lista[0].desc?.split(" · ")[1] ?? "Feito na casa"}</text>
    <!-- Preço -->
    <text x="74" y="64" font-family="ui-monospace, monospace" font-size="11" font-weight="600" fill={colors.text}>R$ {lista[0].preco}</text>
    <!-- Mini CTA -->
    <rect x="116" y="56" width="36" height="14" rx="7" fill={colors.accent}/>
    <text x="134" y="65.5" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="5.5" font-weight="600" fill={colors.bg}>+ adicionar</text>
  </g>

  <!-- ====== LISTA DE ITENS ====== -->
  <text x="80" y="206" font-family="ui-monospace, monospace" font-size="5" fill={colors.accent} letter-spacing="0.5" font-weight="500">{categorias[0].toUpperCase()}</text>

  {lista.slice(1, 4).map((item, i) => (
    <g transform={`translate(80, ${214 + i * 36})`}>
      <!-- Photo -->
      <rect width="32" height="32" rx="3" fill={colors.surface}/>
      <circle cx="16" cy="16" r="11" fill={colors.accent} opacity={0.8 - i * 0.15}/>
      <circle cx="13" cy="13" r="2" fill={colors.accentDeep} opacity="0.7"/>
      <circle cx="19" cy="18" r="1.5" fill={colors.accentDeep} opacity="0.6"/>

      <!-- Texto -->
      <text x="38" y="11" font-family="Georgia, serif" font-size="7" font-weight="600" fill={colors.text}>{item.nome}</text>
      <text x="38" y="19" font-family="ui-sans-serif, system-ui" font-size="5" fill={colors.textSoft}>{item.desc?.split(" · ")[0] ?? "Receita da casa"}</text>
      <text x="38" y="26" font-family="ui-monospace, monospace" font-size="6.5" font-weight="600" fill={colors.text}>R$ {item.preco}</text>

      <!-- Plus button -->
      <circle cx="148" cy="16" r="9" fill="none" stroke={colors.line} stroke-width="0.7"/>
      <line x1="143" y1="16" x2="153" y2="16" stroke={colors.text} stroke-width="1.2" stroke-linecap="round"/>
      <line x1="148" y1="11" x2="148" y2="21" stroke={colors.text} stroke-width="1.2" stroke-linecap="round"/>

      <!-- Divisor -->
      {i < 2 && (
        <line x1="0" y1="34" x2="160" y2="34" stroke={colors.line} stroke-width="0.4"/>
      )}
    </g>
  ))}

  <!-- ====== CTA STICKY ====== -->
  <g transform="translate(80, 332)">
    <rect width="160" height="28" rx="6" fill="#25D366"/>
    <g transform="translate(20, 14)">
      <path d="M 6 0 A 6 6 0 1 0 0.6 4.4 L 0 6 L 1.6 5.4 A 6 6 0 0 0 6 0 Z" fill={colors.bg}/>
    </g>
    <text x="80" y="18" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="7" font-weight="600" fill={colors.bg}>{cta} →</text>
  </g>

  <!-- ====== FOOTER ====== -->
  <g transform="translate(80, 366)">
    <text font-family="ui-monospace, monospace" font-size="4.5" fill={colors.textSoft} letter-spacing="0.3">ABERTO 18h–23h</text>
    <text x="56" y="0" font-family="ui-monospace, monospace" font-size="4.5" fill={colors.textSoft} letter-spacing="0.3">·</text>
    <text x="62" y="0" font-family="ui-monospace, monospace" font-size="4.5" fill={colors.textSoft} letter-spacing="0.3">PEDIDO MÍN R$ 30</text>
    <text x="160" y="0" text-anchor="end" font-family="ui-monospace, monospace" font-size="4.5" fill={colors.textSoft} letter-spacing="0.3">@{nome.toLowerCase().replace(/\s/g, "")}</text>
  </g>
</svg>

<style>
  .mockup-svg {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 4px;
  }
</style>
