---
// Seção FAQ — antecipa objeções de dono de PME antes do CTA final.
// Native <details>/<summary> = acessível, zero JS, abre/fecha do navegador.
// Schema.org FAQPage embedado em JSON-LD pra Google rich snippets.

const perguntas = [
  {
    q: "Vou ter que pagar mensalidade?",
    a: "Não. É um pagamento único — R$ 247 cardápio QR ou R$ 397 site. Hospedagem por 1 ano inclusa. Renovação anual fica em R$ 60 (custo do servidor + domínio, sem lucro nosso)."
  },
  {
    q: "E se eu quiser mudar coisas depois da entrega?",
    a: "Ajustes ilimitados nos primeiros 30 dias, sem cobrança. Depois disso, ajustes pequenos (trocar foto, atualizar preço, adicionar item) custam R$ 30 por solicitação ou você mesmo edita por uma área simples que mostramos como usar."
  },
  {
    q: "Preciso entender de tecnologia?",
    a: "Não. A gente cuida de hospedagem, domínio, certificado de segurança e SEO básico. Você só manda o nome do negócio, fotos e o que quer que apareça. Recebe o link pronto — abre no celular e funciona."
  },
  {
    q: "Quanto tempo até estar no ar?",
    a: "Cardápio QR: 5 dias úteis. Site profissional: 7 dias úteis. O contador começa no dia que recebemos suas fotos e textos. Se você não tem material pronto, te ajudamos a juntar — também sem custo extra."
  },
  {
    q: "E se eu não gostar do resultado?",
    a: "Garantia de 7 dias após a entrega. Se não gostar, devolvemos 100% do valor — sem letra miúda, sem precisar justificar. Até hoje a gente nunca precisou aplicar essa garantia, mas ela existe pra você sair tranquilo."
  },
  {
    q: "Quem responde meu WhatsApp?",
    a: "O Lucas, co-fundador, fala com você do orçamento à entrega. Não tem terceirização, não tem freelancer escondido. Resposta em até 30 minutos durante horário comercial."
  }
];

// Schema.org FAQPage — Google usa pra exibir o FAQ direto na busca
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": perguntas.map((p) => ({
    "@type": "Question",
    "name": p.q,
    "acceptedAnswer": { "@type": "Answer", "text": p.a }
  }))
};
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="praca-container">
    <p class="faq__eyebrow reveal">Antes que você pergunte</p>
    <h2 id="faq-title" class="faq__title reveal">Perguntas frequentes.</h2>

    <div class="faq__lista reveal-stagger">
      {perguntas.map((p, i) => (
        <details class="faq__item reveal" open={i === 0}>
          <summary class="faq__pergunta">
            <span class="faq__num">0{i + 1}</span>
            <span class="faq__texto">{p.q}</span>
            <span class="faq__chevron" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 5l4 4 4-4"/>
              </svg>
            </span>
          </summary>
          <div class="faq__resposta">{p.a}</div>
        </details>
      ))}
    </div>

    <p class="faq__rodape reveal">
      Outra pergunta?
      <a class="praca-link" href="#contato">Manda no WhatsApp</a>
      &nbsp;que a gente responde em até 30 minutos.
    </p>
  </div>
</section>

<!-- Schema.org JSON-LD pra rich snippets do Google -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>

<style>
  .faq {
    background-color: var(--color-cream);
    padding-block: 5rem;
  }
  @media (min-width: 768px) { .faq { padding-block: 7rem; } }

  .faq__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-clay);
    margin: 0 0 0.85rem 0;
  }
  .faq__title {
    font-size: clamp(2rem, 5vw + 0.5rem, 3.5rem);
    margin: 0 0 3rem 0;
    letter-spacing: -0.02em;
  }

  .faq__lista {
    max-width: 56rem;
    display: flex;
    flex-direction: column;
  }

  .faq__item {
    border-top: 1px solid var(--color-line-strong);
    padding: 1.25rem 0;
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--color-line-strong);
  }

  .faq__pergunta {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.6vw + 0.5rem, 1.4rem);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.015em;
    line-height: 1.35;
    transition: color 0.3s var(--ease-praca);
    font-variation-settings: "opsz" 36;
  }
  .faq__pergunta::-webkit-details-marker { display: none; }
  .faq__pergunta:hover { color: var(--color-clay-deep); }

  .faq__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-clay);
    flex-shrink: 0;
    transform: translateY(-2px);
    width: 1.5rem;
  }
  .faq__texto { flex: 1; }
  .faq__chevron {
    flex-shrink: 0;
    color: var(--color-ink-soft);
    transition: transform 0.4s var(--ease-praca);
    transform: translateY(-2px);
  }
  .faq__item[open] .faq__chevron {
    transform: translateY(-2px) rotate(180deg);
  }

  .faq__resposta {
    margin-top: 0.85rem;
    margin-left: 2.5rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 65ch;
    /* Animação de abrir suave */
    animation: faq-open 0.5s var(--ease-praca);
  }
  @keyframes faq-open {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .faq__rodape {
    margin-top: 2.5rem;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__chevron, .faq__resposta { animation: none; transition: none; }
  }
</style>

<script>
  import { initReveal } from "../lib/motion.ts";
  initReveal();
</script>
