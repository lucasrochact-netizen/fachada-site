---
import Logo from "./Logo.astro";
import NoiseTexture from "./NoiseTexture.astro";
import { whatsappUrl } from "../lib/whatsapp.ts";

const heroHref = whatsappUrl("hero");
---

<section class="hero" aria-labelledby="hero-title">
  <NoiseTexture opacity={0.05} baseFrequency={0.85} />

  <header class="hero__nav praca-container">
    <Logo href="#topo" />
    <a
      class="hero__nav-cta"
      href={heroHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar no WhatsApp"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </header>

  <div class="hero__inner praca-container">
    <h1 id="hero-title" class="hero__title tracking-display">
      <span class="hero__line" data-hero-line>
        Cardápio em PDF<span class="dot-clay">.</span>
      </span>
      <span class="hero__line" data-hero-line>
        Site de 2018<span class="dot-clay">.</span>
      </span>
      <span class="hero__line hero__line--last" data-hero-line>
        Seu concorrente já resolveu<span class="dot-clay">.</span>
      </span>
    </h1>

    <p class="hero__subtitle" data-hero-line>
      A gente arruma sua presença digital em <strong>5 dias</strong>.
      Cardápio QR por <span class="font-mono-praca">R$&nbsp;247</span>.
      Site profissional por <span class="font-mono-praca">R$&nbsp;397</span>.
    </p>

    <div class="hero__ctas" data-hero-line>
      <a
        href={heroHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary cursor-clay"
      >
        Falar no WhatsApp
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" />
        </svg>
      </a>
      <a href="#galeria" class="hero__secondary praca-link">
        ou ver alguns trabalhos
      </a>
    </div>
  </div>

  <p class="hero__footnote praca-container" data-hero-line>
    Para pequenas e médias empresas no Brasil inteiro.
  </p>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-paper);
    padding-top: 1.5rem;
    padding-bottom: 4.5rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* Topbar */
  .hero__nav {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 3rem;
  }
  .hero__nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 0.85rem;
    font-weight: 500;
    transition:
      background-color 0.4s var(--ease-praca),
      color 0.4s var(--ease-praca),
      border-color 0.4s var(--ease-praca);
  }
  .hero__nav-cta:hover {
    background-color: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .hero__nav-cta svg { color: #25D366; transition: color 0.3s var(--ease-praca); }
  .hero__nav-cta:hover svg { color: #25D366; }

  /* Inner */
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  /* H1 */
  .hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 9vw + 0.5rem, 5.5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    font-variation-settings: "opsz" 144;
    max-width: 18ch;
  }
  .hero__line {
    display: block;
  }
  .hero__line--last {
    color: var(--color-ink);
  }
  .dot-clay {
    color: var(--color-clay);
  }

  /* Subtitle */
  .hero__subtitle {
    margin-top: 2rem;
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--color-ink-soft);
    font-size: clamp(1rem, 1.6vw + 0.6rem, 1.3rem);
    line-height: 1.55;
    max-width: 52ch;
  }
  .hero__subtitle strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  /* CTAs */
  .hero__ctas {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .hero__secondary {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Footnote */
  .hero__footnote {
    position: relative;
    z-index: 1;
    margin-top: 5rem;
    color: var(--color-ink-soft);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Pre-animação: linhas escondidas até motion entrar.
     Se motion falhar (no-JS), :where(html.no-js) revela. */
  html.has-motion [data-hero-line] {
    opacity: 0;
    transform: translateY(40px);
  }

  @media (min-width: 768px) {
    .hero { padding-bottom: 6rem; }
    .hero__inner { padding-top: 5rem; }
    .hero__title { line-height: 0.96; }
  }
  @media (min-width: 1024px) {
    .hero__inner { padding-top: 7rem; padding-bottom: 5rem; }
  }
</style>

<script>
  import { animateHeroLines } from "../lib/motion.ts";
  // .has-motion já foi aplicado pelo inline script do Base.astro (antes do paint).
  requestAnimationFrame(() => animateHeroLines());
</script>
