---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---

<Base>
  <header class="praca-container" style="padding-top: 1.5rem;">
    <Logo href="#" />
  </header>

  <main class="praca-container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <h1 style="font-size: var(--text-4xl); margin-bottom: 1rem;">Praça em construção</h1>
    <p style="color: var(--color-ink-soft); max-width: 50ch;">
      Site sendo montado fase por fase. Volte em breve.
    </p>
  </main>
</Base>
