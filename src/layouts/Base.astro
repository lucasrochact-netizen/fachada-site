---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Praça — presença digital pra cidade pequena",
  description = "Praça — cardápio QR R$ 247, site profissional R$ 397, garantia de 7 dias. Atendemos cidades pequenas em Minas Gerais."
} = Astro.props;

const url = Astro.site ?? "https://praca.example.com/";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4EFE6" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={String(url)} />

    <!-- Preload das fontes críticas (Fraunces + Manrope) — usadas no hero, peso variável -->
    <link
      rel="preload"
      href="/fonts/fraunces-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={String(url)} />
    <meta property="og:image" content="/og-image.svg" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.svg" />

    <title>{title}</title>

    <!--
      Progressive enhancement: marca o html com .has-motion antes do paint, só
      se JS estiver ativo. CSS usa essa classe pra esconder .reveal e .data-hero-line
      antes da animação. Sem JS, conteúdo aparece visível por default.
    -->
    <script is:inline>document.documentElement.classList.add("has-motion");</script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
