---
// Mockup SVG inline de um "celular com cardápio QR aberto".
// Coerente com a estética terracota+creme+tinta.
interface Props {
  nome: string;
  cidade: string;
  paleta?: "clay" | "moss" | "ink";
  itens?: Array<{ nome: string; preco: string }>;
  emoji?: string;
}
const {
  nome,
  cidade,
  paleta = "clay",
  itens = [
    { nome: "Margherita", preco: "42,00" },
    { nome: "Calabresa", preco: "39,00" },
    { nome: "Frango Catupiry", preco: "45,00" }
  ],
  emoji = ""
} = Astro.props;

const colors = {
  clay: { bg: "#FBF8F2", accent: "#B5563A", accentDeep: "#8B3E29" },
  moss: { bg: "#F4EFE6", accent: "#5A6B4F", accentDeep: "#3a4632" },
  ink: { bg: "#F4EFE6", accent: "#1A1614", accentDeep: "#1A1614" }
}[paleta];
---

<svg
  class="mockup-svg"
  viewBox="0 0 320 400"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`Mockup do cardápio QR de ${nome}, em ${cidade}`}
>
  <!-- Background -->
  <rect width="320" height="400" fill={colors.bg}/>

  <!-- "Telefone" -->
  <rect x="80" y="20" width="160" height="360" rx="20" fill="#1A1614"/>
  <rect x="86" y="32" width="148" height="336" rx="14" fill={colors.bg}/>

  <!-- Notch -->
  <rect x="140" y="32" width="40" height="6" rx="3" fill="#1A1614"/>

  <!-- Header da página do cardápio -->
  <text x="160" y="68" text-anchor="middle" font-family="Georgia, serif" font-size="13" font-weight="700" fill="#1A1614" letter-spacing="-0.4">
    {nome}
  </text>
  <text x="160" y="82" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="7" fill="#4A4340" letter-spacing="0.3">
    {cidade.toUpperCase()}
  </text>

  <!-- Linha divisória -->
  <line x1="100" y1="92" x2="220" y2="92" stroke="rgba(26, 22, 20, 0.12)" stroke-width="0.5"/>

  <!-- "Categoria" tag -->
  <rect x="100" y="100" width="34" height="12" rx="2" fill={colors.accent} fill-opacity="0.12"/>
  <text x="117" y="109" text-anchor="middle" font-family="ui-monospace, monospace" font-size="6" font-weight="600" fill={colors.accentDeep} letter-spacing="0.5">
    DESTAQUE
  </text>

  <!-- Itens do cardápio -->
  {itens.slice(0, 3).map((item, i) => (
    <g transform={`translate(0, ${118 + i * 60})`}>
      <!-- Foto placeholder -->
      <rect x="100" y="0" width="44" height="44" rx="4" fill={colors.accent} opacity="0.85"/>
      <circle cx="122" cy="22" r="10" fill={colors.bg} opacity="0.3"/>

      <!-- Nome do item -->
      <text x="152" y="14" font-family="Georgia, serif" font-size="10" font-weight="600" fill="#1A1614">
        {item.nome}
      </text>
      <!-- Preço -->
      <text x="152" y="28" font-family="ui-monospace, monospace" font-size="9" font-weight="500" fill={colors.accentDeep}>
        R$ {item.preco}
      </text>
      <!-- Linha -->
      <line x1="152" y1="38" x2="220" y2="38" stroke="rgba(26, 22, 20, 0.06)" stroke-width="0.5"/>
    </g>
  ))}

  <!-- CTA "Pedir" no rodapé -->
  <rect x="100" y="318" width="120" height="28" rx="3" fill={colors.accent}/>
  <text x="160" y="335" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="9" font-weight="600" fill={colors.bg}>
    Falar no WhatsApp
  </text>

  <!-- "Praça" footer mark -->
  <text x="160" y="358" text-anchor="middle" font-family="Georgia, serif" font-size="7" fill="rgba(26, 22, 20, 0.4)" letter-spacing="0.3">
    {emoji} {cidade}
  </text>
</svg>

<style>
  .mockup-svg {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 4px;
  }
</style>
