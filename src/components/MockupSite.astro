---
// Mockup SVG inline de "site one-page" — 3 variantes ricas por tipo de negócio.
// Cada variante mostra: browser, header com nav, hero c/ CTA + foto, secao
// específica (serviços/listings/bento), trust signals, banda CTA, footer.
//
// Princípios aplicados (research em landing best practices PME 2026):
// - Hero claro com headline + subhead + CTA específica (não "Saiba mais")
// - Mostrar conteúdo do negócio real (não 3D abstrato)
// - 2-3 cores principais
// - Trust signals visíveis (estrelas, avaliações, anos de mercado)
// - CTAs específicas tipo "Agendar avaliação" / "Falar com a Aliança"

interface Props {
  nome: string;
  cidade: string;
  paleta?: "clay" | "moss" | "ink";
  tagline?: string;
  tipo?: "fitness" | "imobiliaria" | "saude";
}
const {
  nome,
  cidade,
  paleta = "clay",
  tagline = "Atendimento de qualidade",
  tipo = "fitness"
} = Astro.props;

const colors = {
  clay: { bg: "#FBF8F2", accent: "#B5563A", accentDeep: "#8B3E29", accentSoft: "#D9A89A", chip: "#F4EFE6" },
  moss: { bg: "#F4EFE6", accent: "#5A6B4F", accentDeep: "#3a4632", accentSoft: "#a3b194", chip: "#e8e8da" },
  ink:  { bg: "#F4EFE6", accent: "#1A1614", accentDeep: "#000000", accentSoft: "#4A4340", chip: "#E8E0D2" }
}[paleta];

// Nav items por tipo
const navByTipo = {
  fitness:     ["Início", "Aulas", "Planos", "Agendar"],
  imobiliaria: ["Imóveis", "Venda", "Aluguel", "Contato"],
  saude:       ["Tratamentos", "Equipe", "Convênios", "Agendar"]
};
const nav = navByTipo[tipo];

// CTA do hero por tipo
const heroCta = {
  fitness:     "Agendar avaliação",
  imobiliaria: "Ver imóveis",
  saude:       "Agendar consulta"
}[tipo];

// Domínio simulado
const dominio = nome.toLowerCase().replace(/[^a-z0-9]/g, "") + ".com.br";
---

<svg
  class="mockup-svg"
  viewBox="0 0 320 400"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`Mockup do site de ${nome}, em ${cidade}`}
  preserveAspectRatio="xMidYMid meet"
>
  <!-- Background sombra -->
  <rect width="320" height="400" fill="#E8E0D2"/>

  <!-- Browser frame -->
  <rect x="14" y="34" width="292" height="332" rx="6" fill={colors.bg} stroke="rgba(26, 22, 20, 0.14)" stroke-width="0.6"/>

  <!-- Browser top bar -->
  <rect x="14" y="34" width="292" height="20" rx="6" fill="#E8E0D2"/>
  <rect x="14" y="46" width="292" height="8" fill="#E8E0D2"/>
  <circle cx="26" cy="44" r="2.5" fill="#B5563A"/>
  <circle cx="34" cy="44" r="2.5" fill="#C9A961"/>
  <circle cx="42" cy="44" r="2.5" fill="#5A6B4F"/>
  <rect x="76" y="40" width="180" height="8" rx="2" fill="#FBF8F2" stroke="rgba(26, 22, 20, 0.08)" stroke-width="0.4"/>
  <text x="166" y="46" text-anchor="middle" font-family="ui-monospace, monospace" font-size="4.5" fill="rgba(26, 22, 20, 0.5)">{dominio}</text>

  <!-- ====== HEADER ====== -->
  <rect x="14" y="54" width="292" height="20" fill={colors.bg}/>
  <line x1="14" y1="74" x2="306" y2="74" stroke="rgba(26, 22, 20, 0.06)" stroke-width="0.5"/>
  <!-- Logo -->
  <text x="24" y="68" font-family="Georgia, serif" font-size="9" font-weight="700" fill="#1A1614" letter-spacing="-0.3">
    {nome.split(" ")[0]}<tspan fill={colors.accent}>.</tspan>
  </text>
  <!-- Nav items -->
  {nav.map((item, i) => (
    <text x={186 + i * 32} y="68" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="5.5" font-weight={i === nav.length - 1 ? "600" : "400"} fill={i === nav.length - 1 ? colors.accent : "#4A4340"}>
      {item}
    </text>
  ))}

  {tipo === "fitness" && (
    <>
      <!-- ====== HERO FITNESS ====== -->
      <text x="24" y="100" font-family="Georgia, serif" font-size="14" font-weight="700" fill="#1A1614" letter-spacing="-0.5">{tagline.split(" ").slice(0, 2).join(" ")}</text>
      <text x="24" y="116" font-family="Georgia, serif" font-size="14" font-weight="700" fill="#1A1614" letter-spacing="-0.5">{tagline.split(" ").slice(2).join(" ") || "que funciona"}<tspan fill={colors.accent}>.</tspan></text>
      <text x="24" y="131" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">Aulas individuais e em pequenos grupos.</text>
      <text x="24" y="140" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">Avaliação postural inclusa.</text>
      <!-- CTA pill -->
      <rect x="24" y="148" width="78" height="18" rx="9" fill={colors.accent}/>
      <text x="63" y="160" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="6.5" font-weight="600" fill={colors.bg}>{heroCta} →</text>
      <rect x="106" y="148" width="56" height="18" rx="9" fill="none" stroke={colors.accent} stroke-width="0.8"/>
      <text x="134" y="160" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="6.5" font-weight="500" fill={colors.accent}>Ver planos</text>

      <!-- Hero image: silhueta pilates -->
      <rect x="200" y="86" width="98" height="86" rx="4" fill={colors.accentSoft} opacity="0.95"/>
      <!-- Stylized pilates figure -->
      <circle cx="245" cy="108" r="5" fill={colors.accent}/>
      <path d="M 240 114 Q 245 130 252 138 L 268 142 M 240 114 Q 232 124 222 130 M 248 138 Q 252 152 248 162 M 248 138 Q 260 145 270 148" stroke={colors.accent} stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <line x1="218" y1="160" x2="278" y2="160" stroke={colors.bg} stroke-width="1.5" opacity="0.6"/>

      <!-- ====== SECTION: NOSSAS AULAS ====== -->
      <text x="24" y="186" font-family="ui-monospace, monospace" font-size="5" fill={colors.accent} letter-spacing="0.6" font-weight="500">NOSSAS AULAS</text>

      <!-- Card 1: Solo -->
      <rect x="24" y="194" width="86" height="58" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
      <circle cx="40" cy="208" r="6" fill={colors.accent} opacity="0.15"/>
      <circle cx="40" cy="208" r="2.5" fill={colors.accent}/>
      <text x="52" y="206" font-family="Georgia, serif" font-size="7.5" font-weight="600" fill="#1A1614">Solo</text>
      <text x="52" y="214" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">individual</text>
      <text x="32" y="232" font-family="ui-monospace, monospace" font-size="9" font-weight="600" fill="#1A1614">R$280</text>
      <text x="62" y="232" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">/aula</text>
      <line x1="32" y1="238" x2="100" y2="238" stroke="rgba(26, 22, 20, 0.08)" stroke-width="0.4"/>
      <text x="32" y="246" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">Avaliação postural</text>

      <!-- Card 2: Duo -->
      <rect x="118" y="194" width="86" height="58" rx="3" fill={colors.bg} stroke={colors.accent} stroke-width="1"/>
      <rect x="118" y="194" width="86" height="14" rx="3" fill={colors.accent}/>
      <text x="161" y="203" text-anchor="middle" font-family="ui-monospace, monospace" font-size="4.5" font-weight="600" fill={colors.bg} letter-spacing="0.5">MAIS PROCURADO</text>
      <text x="126" y="220" font-family="Georgia, serif" font-size="7.5" font-weight="600" fill="#1A1614">Duo</text>
      <text x="126" y="228" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">duas pessoas</text>
      <text x="126" y="240" font-family="ui-monospace, monospace" font-size="9" font-weight="600" fill="#1A1614">R$200</text>
      <text x="156" y="240" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">/cada</text>

      <!-- Card 3: Grupo -->
      <rect x="212" y="194" width="86" height="58" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
      <g transform="translate(228, 208)">
        <circle cx="-6" cy="0" r="2.5" fill={colors.accent}/>
        <circle cx="0" cy="0" r="2.5" fill={colors.accent}/>
        <circle cx="6" cy="0" r="2.5" fill={colors.accent}/>
      </g>
      <text x="240" y="206" font-family="Georgia, serif" font-size="7.5" font-weight="600" fill="#1A1614">Grupo</text>
      <text x="240" y="214" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">até 6 alunos</text>
      <text x="220" y="232" font-family="ui-monospace, monospace" font-size="9" font-weight="600" fill="#1A1614">R$150</text>
      <text x="252" y="232" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">/aula</text>
      <line x1="220" y1="238" x2="290" y2="238" stroke="rgba(26, 22, 20, 0.08)" stroke-width="0.4"/>
      <text x="220" y="246" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">2× por semana</text>

      <!-- ====== SECTION: AGENDA ====== -->
      <text x="24" y="266" font-family="ui-monospace, monospace" font-size="5" fill={colors.accent} letter-spacing="0.6" font-weight="500">AGENDA DA SEMANA</text>
      <g transform="translate(24, 272)">
        {["seg","ter","qua","qui","sex","sáb"].map((d, i) => (
          <text x={5 + i * 45} y="6" text-anchor="middle" font-family="ui-monospace, monospace" font-size="4.5" fill="#4A4340" letter-spacing="0.3">{d}</text>
        ))}
        {[7, 9, 18].map((h, hi) => (
          <g transform={`translate(0, ${12 + hi * 12})`}>
            <text x="-15" y="5" font-family="ui-monospace, monospace" font-size="4.5" fill="#4A4340">{h}h</text>
            {[0,1,2,3,4,5].map((di) => {
              const filled = (di + hi) % 3 !== 0;
              return (
                <circle cx={5 + di * 45} cy="2" r="2" fill={filled ? colors.accent : "rgba(26, 22, 20, 0.1)"}/>
              );
            })}
          </g>
        ))}
      </g>
    </>
  )}

  {tipo === "imobiliaria" && (
    <>
      <!-- ====== HERO IMOBILIARIA ====== -->
      <text x="24" y="100" font-family="Georgia, serif" font-size="14" font-weight="700" fill="#1A1614" letter-spacing="-0.5">{tagline.split(" ").slice(0, 2).join(" ")}</text>
      <text x="24" y="116" font-family="Georgia, serif" font-size="14" font-weight="700" fill="#1A1614" letter-spacing="-0.5">em {cidade.split(" ")[0]}<tspan fill={colors.accent}>.</tspan></text>
      <text x="24" y="131" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">Atendimento pessoal, sem corretor terceirizado.</text>
      <text x="24" y="140" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">Vistoria com você desde a primeira visita.</text>
      <!-- CTA -->
      <rect x="24" y="148" width="92" height="18" rx="2" fill={colors.accent}/>
      <text x="70" y="160" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="6.5" font-weight="600" fill={colors.bg}>Ver imóveis →</text>
      <text x="124" y="161" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">ou ligar (31) 9999-9999</text>

      <!-- Hero image: skyline -->
      <rect x="200" y="86" width="98" height="86" rx="4" fill={colors.accentSoft}/>
      <!-- Buildings -->
      <rect x="208" y="120" width="14" height="48" fill={colors.accent} opacity="0.7"/>
      <rect x="226" y="100" width="18" height="68" fill={colors.accent} opacity="0.85"/>
      <rect x="248" y="130" width="14" height="38" fill={colors.accent} opacity="0.6"/>
      <rect x="266" y="115" width="18" height="53" fill={colors.accent} opacity="0.8"/>
      <!-- Windows -->
      {[0,1,2,3].map((row) => (
        [0,1].map((col) => (
          <rect x={210 + col * 5} y={124 + row * 9} width="2" height="3" fill={colors.bg} opacity="0.5"/>
        ))
      )).flat()}
      {[0,1,2,3,4,5].map((row) => (
        [0,1,2].map((col) => (
          <rect x={228 + col * 5} y={104 + row * 9} width="2" height="3" fill={colors.bg} opacity="0.5"/>
        ))
      )).flat()}
      <!-- Sun -->
      <circle cx="285" cy="100" r="4" fill="#C9A961"/>

      <!-- ====== SECTION: EM DESTAQUE ====== -->
      <text x="24" y="186" font-family="ui-monospace, monospace" font-size="5" fill={colors.accent} letter-spacing="0.6" font-weight="500">EM DESTAQUE · 3 IMÓVEIS</text>

      <!-- Property card 1 -->
      <g transform="translate(24, 194)">
        <rect width="86" height="78" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
        <rect x="0" y="0" width="86" height="38" rx="3" fill={colors.accentSoft}/>
        <path d="M 30 26 L 43 14 L 56 26 L 56 38 L 30 38 Z" fill={colors.accent}/>
        <rect x="38" y="28" width="6" height="8" fill={colors.bg} opacity="0.6"/>
        <rect x="46" y="28" width="6" height="8" fill={colors.bg} opacity="0.6"/>
        <rect x="3" y="3" width="20" height="9" rx="2" fill="rgba(26, 22, 20, 0.7)"/>
        <text x="13" y="9.5" text-anchor="middle" font-family="ui-monospace, monospace" font-size="4" font-weight="600" fill={colors.bg}>VENDA</text>
        <text x="6" y="50" font-family="ui-monospace, monospace" font-size="8" font-weight="600" fill="#1A1614">R$ 1,2M</text>
        <text x="6" y="59" font-family="ui-sans-serif, system-ui" font-size="5" font-weight="500" fill="#1A1614">Apto · Cidade Jardim</text>
        <text x="6" y="67" font-family="ui-sans-serif, system-ui" font-size="4.5" fill="#4A4340">3 dorm · 2 vagas · 110m²</text>
        <text x="6" y="74" font-family="ui-sans-serif, system-ui" font-size="4.5" fill={colors.accent} font-weight="500">Ver detalhes →</text>
      </g>

      <!-- Property card 2 -->
      <g transform="translate(118, 194)">
        <rect width="86" height="78" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
        <rect x="0" y="0" width="86" height="38" rx="3" fill={colors.accentSoft} opacity="0.85"/>
        <path d="M 25 28 L 38 16 L 51 28 L 51 38 L 25 38 Z M 51 28 L 60 22 L 60 38 L 51 38 Z" fill={colors.accent}/>
        <rect x="3" y="3" width="20" height="9" rx="2" fill={colors.accent}/>
        <text x="13" y="9.5" text-anchor="middle" font-family="ui-monospace, monospace" font-size="4" font-weight="600" fill={colors.bg}>NOVO</text>
        <text x="6" y="50" font-family="ui-monospace, monospace" font-size="8" font-weight="600" fill="#1A1614">R$ 680K</text>
        <text x="6" y="59" font-family="ui-sans-serif, system-ui" font-size="5" font-weight="500" fill="#1A1614">Casa · Savassi</text>
        <text x="6" y="67" font-family="ui-sans-serif, system-ui" font-size="4.5" fill="#4A4340">2 dorm · 1 vaga · 85m²</text>
        <text x="6" y="74" font-family="ui-sans-serif, system-ui" font-size="4.5" fill={colors.accent} font-weight="500">Ver detalhes →</text>
      </g>

      <!-- Property card 3 -->
      <g transform="translate(212, 194)">
        <rect width="86" height="78" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
        <rect x="0" y="0" width="86" height="38" rx="3" fill={colors.accentSoft} opacity="0.95"/>
        <rect x="22" y="14" width="42" height="24" fill={colors.accent}/>
        <rect x="28" y="20" width="6" height="6" fill={colors.bg} opacity="0.6"/>
        <rect x="40" y="20" width="6" height="6" fill={colors.bg} opacity="0.6"/>
        <rect x="52" y="20" width="6" height="6" fill={colors.bg} opacity="0.6"/>
        <rect x="3" y="3" width="20" height="9" rx="2" fill="rgba(26, 22, 20, 0.7)"/>
        <text x="13" y="9.5" text-anchor="middle" font-family="ui-monospace, monospace" font-size="4" font-weight="600" fill={colors.bg}>ALUGUEL</text>
        <text x="6" y="50" font-family="ui-monospace, monospace" font-size="8" font-weight="600" fill="#1A1614">R$ 4.200</text>
        <text x="50" y="50" font-family="ui-sans-serif, system-ui" font-size="4" fill="#4A4340">/mês</text>
        <text x="6" y="59" font-family="ui-sans-serif, system-ui" font-size="5" font-weight="500" fill="#1A1614">Apto · Lourdes</text>
        <text x="6" y="67" font-family="ui-sans-serif, system-ui" font-size="4.5" fill="#4A4340">4 dorm · 3 vagas · 180m²</text>
        <text x="6" y="74" font-family="ui-sans-serif, system-ui" font-size="4.5" fill={colors.accent} font-weight="500">Ver detalhes →</text>
      </g>

      <!-- ====== TRUST ROW ====== -->
      <g transform="translate(24, 282)">
        <rect width="274" height="22" rx="3" fill={colors.chip}/>
        <g transform="translate(8, 11)">
          <text x="0" y="3" font-family="Georgia, serif" font-size="9" font-weight="700" fill="#1A1614">12</text>
          <text x="14" y="3" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">anos no mercado</text>
        </g>
        <line x1="100" y1="4" x2="100" y2="18" stroke="rgba(26, 22, 20, 0.15)" stroke-width="0.5"/>
        <g transform="translate(108, 11)">
          <text x="0" y="3" font-family="Georgia, serif" font-size="9" font-weight="700" fill="#1A1614">CRECI</text>
          <text x="34" y="3" font-family="ui-sans-serif, system-ui" font-size="5" fill="#4A4340">12345-MG</text>
        </g>
        <line x1="180" y1="4" x2="180" y2="18" stroke="rgba(26, 22, 20, 0.15)" stroke-width="0.5"/>
        <g transform="translate(188, 11)">
          <text x="0" y="3" font-family="ui-monospace, monospace" font-size="6" fill={colors.gold ?? "#C9A961"}>★★★★★</text>
          <text x="0" y="11" font-family="ui-sans-serif, system-ui" font-size="4.5" fill="#4A4340">Google · 4.8 (89)</text>
        </g>
      </g>
    </>
  )}

  {tipo === "saude" && (
    <>
      <!-- ====== HERO SAUDE ====== -->
      <text x="24" y="100" font-family="Georgia, serif" font-size="14" font-weight="700" fill="#1A1614" letter-spacing="-0.5">{tagline.split(" ").slice(0, 2).join(" ")}</text>
      <text x="24" y="116" font-family="Georgia, serif" font-size="14" font-weight="700" fill="#1A1614" letter-spacing="-0.5">{tagline.split(" ").slice(2).join(" ") || `em ${cidade}`}<tspan fill={colors.accent}>.</tspan></text>
      <text x="24" y="131" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">Avaliação inicial gratuita.</text>
      <text x="24" y="140" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">Equipe especializada · 12 convênios.</text>
      <!-- CTA -->
      <rect x="24" y="148" width="98" height="18" rx="9" fill={colors.accent}/>
      <text x="73" y="160" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="6.5" font-weight="600" fill={colors.bg}>{heroCta} →</text>
      <!-- Trust line -->
      <text x="128" y="161" font-family="ui-sans-serif, system-ui" font-size="5.5" fill="#4A4340"><tspan font-family="ui-monospace, monospace" font-weight="600" fill="#C9A961">★★★★★</tspan> 4.9 · 247 avaliações</text>

      <!-- Hero image: smile/face abstract -->
      <rect x="200" y="86" width="98" height="86" rx="4" fill={colors.accentSoft} opacity="0.95"/>
      <circle cx="249" cy="125" r="32" fill={colors.bg}/>
      <!-- eyes -->
      <circle cx="240" cy="120" r="2" fill={colors.accent}/>
      <circle cx="258" cy="120" r="2" fill={colors.accent}/>
      <!-- smile -->
      <path d="M 235 130 Q 249 145 263 130" stroke={colors.accent} stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <!-- teeth showing -->
      <rect x="240" y="132" width="18" height="5" rx="1" fill={colors.bg}/>

      <!-- ====== SECTION: TRATAMENTOS (bento) ====== -->
      <text x="24" y="186" font-family="ui-monospace, monospace" font-size="5" fill={colors.accent} letter-spacing="0.6" font-weight="500">TRATAMENTOS</text>

      <!-- 6 service cards: 3x2 bento grid -->
      {[
        { i: "Limpeza", emoji: "✦" },
        { i: "Clareamento", emoji: "✺" },
        { i: "Implantes", emoji: "◉" },
        { i: "Ortodontia", emoji: "≋" },
        { i: "Estética", emoji: "❀" },
        { i: "Endodontia", emoji: "◈" }
      ].map((s, idx) => {
        const col = idx % 3;
        const row = Math.floor(idx / 3);
        const x = 24 + col * 95;
        const y = 194 + row * 32;
        return (
          <g transform={`translate(${x}, ${y})`}>
            <rect width="86" height="28" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
            <circle cx="14" cy="14" r="7" fill={colors.accent} opacity="0.15"/>
            <text x="14" y="17" text-anchor="middle" font-family="Georgia, serif" font-size="9" font-weight="700" fill={colors.accent}>{s.emoji}</text>
            <text x="26" y="13" font-family="ui-sans-serif, system-ui" font-size="6" font-weight="600" fill="#1A1614">{s.i}</text>
