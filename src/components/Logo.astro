---
// Logo Fachada — wordmark Fraunces + glifo de "moldura" (sua frente, agora online).
// Variantes: tone="ink" (escuro sobre claro) | tone="paper" (claro sobre escuro)
interface Props {
  tone?: "ink" | "paper";
  size?: "sm" | "md";
  href?: string | null;
  class?: string;
}
const { tone = "ink", size = "md", href = null, class: className = "" } = Astro.props;

const color = tone === "ink" ? "var(--color-ink)" : "var(--color-paper)";
const accent = tone === "ink" ? "var(--color-clay)" : "var(--color-clay-light)";
const fontSize = size === "sm" ? "1.05rem" : "1.25rem";
const glifoSize = size === "sm" ? 18 : 22;
---

<Fragment>
  {href ? (
    <a href={href} class={`fachada-logo ${className}`} aria-label="Fachada" style={`color: ${color};`}>
      <span class="fachada-logo__glifo" aria-hidden="true">
        <svg width={glifoSize} height={glifoSize} viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2.5" y="2.5" width="17" height="17" rx="1.5" stroke={color} stroke-width="1.4" />
          <rect x="6" y="6" width="10" height="6" fill={accent} />
        </svg>
      </span>
      <span class="fachada-logo__word" style={`font-size: ${fontSize};`}>
        Fachada<span class="fachada-logo__dot" style={`background-color: ${accent};`}></span>
      </span>
    </a>
  ) : (
    <div class={`fachada-logo ${className}`} aria-label="Fachada" style={`color: ${color};`}>
      <span class="fachada-logo__glifo" aria-hidden="true">
        <svg width={glifoSize} height={glifoSize} viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2.5" y="2.5" width="17" height="17" rx="1.5" stroke={color} stroke-width="1.4" />
          <rect x="6" y="6" width="10" height="6" fill={accent} />
        </svg>
      </span>
      <span class="fachada-logo__word" style={`font-size: ${fontSize};`}>
        Fachada<span class="fachada-logo__dot" style={`background-color: ${accent};`}></span>
      </span>
    </div>
  )}
</Fragment>

<style>
  .fachada-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    line-height: 1;
  }
  .fachada-logo__glifo {
    display: inline-flex;
    transform: translateY(-1px);
  }
  .fachada-logo__word {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    font-variation-settings: "opsz" 24;
    position: relative;
    padding-right: 0.35rem;
  }
  .fachada-logo__dot {
    position: absolute;
    right: 0;
    bottom: 0.25em;
    width: 4px;
    height: 4px;
    border-radius: 999px;
  }
</style>
