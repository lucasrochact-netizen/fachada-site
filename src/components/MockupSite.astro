---
// Mockup SVG inline de um "site one-page" — viewport laptop com hero + sections.
interface Props {
  nome: string;
  cidade: string;
  paleta?: "clay" | "moss" | "ink";
  tagline?: string;
}
const {
  nome,
  cidade,
  paleta = "clay",
  tagline = "Atendimento de qualidade"
} = Astro.props;

const colors = {
  clay: { bg: "#FBF8F2", accent: "#B5563A", accentSoft: "#D9A89A" },
  moss: { bg: "#F4EFE6", accent: "#5A6B4F", accentSoft: "#a3b194" },
  ink: { bg: "#F4EFE6", accent: "#1A1614", accentSoft: "#4A4340" }
}[paleta];
---

<svg
  class="mockup-svg"
  viewBox="0 0 320 400"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`Mockup do site de ${nome}, em ${cidade}`}
>
  <!-- Background -->
  <rect width="320" height="400" fill="#E8E0D2"/>

  <!-- "Browser frame" -->
  <rect x="20" y="40" width="280" height="320" rx="8" fill={colors.bg} stroke="rgba(26, 22, 20, 0.12)" stroke-width="0.5"/>

  <!-- Browser top bar -->
  <rect x="20" y="40" width="280" height="22" rx="8" fill="#E8E0D2"/>
  <rect x="20" y="50" width="280" height="12" fill="#E8E0D2"/>
  <circle cx="32" cy="51" r="3" fill="#B5563A"/>
  <circle cx="42" cy="51" r="3" fill="#C9A961"/>
  <circle cx="52" cy="51" r="3" fill="#5A6B4F"/>
  <rect x="80" y="46" width="180" height="10" rx="3" fill="#FBF8F2" stroke="rgba(26, 22, 20, 0.08)" stroke-width="0.5"/>
  <text x="170" y="53" text-anchor="middle" font-family="ui-monospace, monospace" font-size="5" fill="rgba(26, 22, 20, 0.5)">
    {nome.toLowerCase().replace(/\s/g, "")}.com.br
  </text>

  <!-- Hero do site -->
  <rect x="20" y="62" width="280" height="120" fill={colors.bg}/>
  <!-- Logo simulado -->
  <text x="32" y="80" font-family="Georgia, serif" font-size="9" font-weight="700" fill="#1A1614">
    {nome.split(" ")[0]}
  </text>
  <!-- nav items -->
  <text x="232" y="80" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">início</text>
  <text x="252" y="80" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">serviços</text>
  <text x="278" y="80" font-family="ui-sans-serif, system-ui" font-size="6" fill="#4A4340">contato</text>

  <!-- H1 hero — duas linhas, com largura limitada pra não invadir a imagem -->
  <text x="32" y="115" font-family="Georgia, serif" font-size="13" font-weight="700" fill="#1A1614" letter-spacing="-0.4" textLength={tagline.length > 18 ? 160 : undefined} lengthAdjust="spacingAndGlyphs">
    {tagline}
  </text>
  <text x="32" y="131" font-family="Georgia, serif" font-size="13" font-weight="700" fill="#1A1614" letter-spacing="-0.4">
    em {cidade}<tspan fill={colors.accent}>.</tspan>
  </text>

  <text x="32" y="148" font-family="ui-sans-serif, system-ui" font-size="7" fill="#4A4340">
    Conheça os serviços que oferecemos
  </text>
  <text x="32" y="158" font-family="ui-sans-serif, system-ui" font-size="7" fill="#4A4340">
    com atendimento personalizado.
  </text>

  <!-- Botão hero -->
  <rect x="32" y="166" width="80" height="20" rx="2" fill={colors.accent}/>
  <text x="72" y="178" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="7" font-weight="600" fill={colors.bg}>
    Falar no WhatsApp
  </text>

  <!-- Imagem hero "abstract" -->
  <rect x="200" y="80" width="92" height="100" rx="4" fill={colors.accentSoft} opacity="0.9"/>
  <circle cx="246" cy="115" r="22" fill={colors.accent}/>
  <rect x="220" y="148" width="55" height="6" rx="2" fill={colors.bg} opacity="0.6"/>

  <!-- Section divider -->
  <line x1="20" y1="190" x2="300" y2="190" stroke="rgba(26, 22, 20, 0.08)" stroke-width="0.5"/>

  <!-- Section "Serviços" — 3 cards -->
  <text x="32" y="208" font-family="Georgia, serif" font-size="10" font-weight="600" fill="#1A1614">Nossos serviços</text>

  <rect x="32" y="218" width="78" height="64" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
  <rect x="40" y="226" width="20" height="20" rx="2" fill={colors.accent} opacity="0.15"/>
  <circle cx="50" cy="236" r="6" fill={colors.accent}/>
  <rect x="40" y="252" width="55" height="3" rx="1" fill="#1A1614"/>
  <rect x="40" y="259" width="40" height="2.5" rx="1" fill="#4A4340"/>
  <rect x="40" y="265" width="50" height="2.5" rx="1" fill="#4A4340"/>

  <rect x="121" y="218" width="78" height="64" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
  <rect x="129" y="226" width="20" height="20" rx="2" fill={colors.accent} opacity="0.15"/>
  <circle cx="139" cy="236" r="6" fill={colors.accent}/>
  <rect x="129" y="252" width="48" height="3" rx="1" fill="#1A1614"/>
  <rect x="129" y="259" width="35" height="2.5" rx="1" fill="#4A4340"/>
  <rect x="129" y="265" width="55" height="2.5" rx="1" fill="#4A4340"/>

  <rect x="210" y="218" width="78" height="64" rx="3" fill={colors.bg} stroke="rgba(26, 22, 20, 0.1)" stroke-width="0.5"/>
  <rect x="218" y="226" width="20" height="20" rx="2" fill={colors.accent} opacity="0.15"/>
  <circle cx="228" cy="236" r="6" fill={colors.accent}/>
  <rect x="218" y="252" width="58" height="3" rx="1" fill="#1A1614"/>
  <rect x="218" y="259" width="40" height="2.5" rx="1" fill="#4A4340"/>
  <rect x="218" y="265" width="48" height="2.5" rx="1" fill="#4A4340"/>

  <!-- CTA banda final -->
  <rect x="32" y="296" width="256" height="50" rx="3" fill="#1A1614"/>
  <text x="160" y="316" text-anchor="middle" font-family="Georgia, serif" font-size="8" font-weight="600" fill="#FBF8F2">
    Pronto pra começar?
  </text>
  <rect x="120" y="324" width="80" height="16" rx="2" fill={colors.accent}/>
  <text x="160" y="335" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-size="6" font-weight="600" fill={colors.bg}>
    Quero contato
  </text>

  <!-- Footer marca Praça -->
  <text x="160" y="380" text-anchor="middle" font-family="ui-monospace, monospace" font-size="6" fill="rgba(26, 22, 20, 0.4)" letter-spacing="0.5">
    feito por Praça
  </text>
</svg>

<style>
  .mockup-svg {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 4px;
  }
</style>
