---
// Seção 2 — "A análise feita pra você" (§4.2 do TASK)
// Lead se sente analisado: dois cards mostrando antes/depois do perfil Google.
---

<section id="analise" class="analise" aria-labelledby="analise-title-antes">
  <div class="praca-container">
    <p class="analise__eyebrow reveal">Sua presença digital hoje</p>
    <h2 id="analise-title-antes" class="analise__title reveal">Seu Google tá assim:</h2>

    <div class="analise__grid reveal-stagger">
      <!-- ANTES -->
      <article class="card-google reveal" aria-label="Mockup do perfil atual incompleto">
        <div class="card-google__head">
          <div class="card-google__brand">
            <span class="card-google__g" aria-hidden="true">G</span>
            <span>oogle</span>
          </div>
          <div class="card-google__chip card-google__chip--bad">Perfil incompleto</div>
        </div>

        <div class="card-google__body">
          <div class="card-google__photo card-google__photo--empty">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="9" cy="9" r="2" />
              <path d="m3 17 5-5 5 5 4-4 4 4" />
            </svg>
            <span>sem foto recente</span>
          </div>

          <div class="card-google__info">
            <div class="card-google__name">Seu Negócio</div>
            <div class="card-google__rating">
              <span class="stars stars--3">★★★<span class="stars__off">★★</span></span>
              <span class="rating-num">3,2</span>
              <span class="rating-count">· 3 avaliações</span>
            </div>
            <div class="card-google__row card-google__row--bad">
              <span class="dot dot--bad" aria-hidden="true"></span>
              Sem cardápio
            </div>
            <div class="card-google__row card-google__row--bad">
              <span class="dot dot--bad" aria-hidden="true"></span>
              Site indisponível
            </div>
            <div class="card-google__row card-google__row--bad">
              <span class="dot dot--bad" aria-hidden="true"></span>
              Sem horário atualizado
            </div>
          </div>
        </div>
      </article>

      <!-- DEPOIS -->
      <article class="card-google card-google--depois reveal" aria-label="Mockup do perfil otimizado">
        <div class="card-google__head">
          <div class="card-google__brand">
            <span class="card-google__g" aria-hidden="true">G</span>
            <span>oogle</span>
          </div>
          <div class="selo-gold">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
              <path d="M5 0l1.2 3.4 3.6.2-2.8 2.4 1 3.5L5 7.6 2 9.5l1-3.5L.2 3.6l3.6-.2L5 0z"/>
            </svg>
            Em 5 dias
          </div>
        </div>

        <div class="card-google__body">
          <div class="card-google__photo card-google__photo--full">
            <div class="ph ph--1"></div>
            <div class="ph ph--2"></div>
            <div class="ph ph--4">+12</div>
          </div>

          <div class="card-google__info">
            <div class="card-google__name">Seu Negócio</div>
            <div class="card-google__rating">
              <span class="stars stars--5">★★★★★</span>
              <span class="rating-num">4,8</span>
              <span class="rating-count">· 47 avaliações</span>
            </div>
            <div class="card-google__row card-google__row--good">
              <span class="dot dot--good" aria-hidden="true"></span>
              Cardápio QR conectado
            </div>
            <div class="card-google__row card-google__row--good">
              <span class="dot dot--good" aria-hidden="true"></span>
              Site responsivo, &lt; 2s
            </div>
            <div class="card-google__row card-google__row--good">
              <span class="dot dot--good" aria-hidden="true"></span>
              Posts semanais agendados
            </div>
          </div>
        </div>
      </article>
    </div>

    <p class="analise__caption reveal">
      Mesmo cliente, mesma cidade, mesma comida.
      <strong>O que muda é só como você aparece.</strong>
    </p>
  </div>
</section>

<style>
  .analise {
    background-color: var(--color-cream);
    padding-block: 5rem;
  }
  @media (min-width: 768px) { .analise { padding-block: 7rem; } }

  .analise__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-clay);
    margin: 0 0 0.85rem 0;
  }
  .analise__title {
    font-size: clamp(2rem, 5vw + 0.5rem, 3.5rem);
    margin: 0 0 3rem 0;
    max-width: 16ch;
    letter-spacing: -0.02em;
  }

  .analise__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .analise__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: stretch;
    }
  }

  .analise__caption {
    margin: 3rem auto 0;
    max-width: 50ch;
    text-align: center;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }
  .analise__caption strong { color: var(--color-ink); font-weight: 600; }

  /* Card Google */
  .card-google {
    background-color: var(--color-paper);
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    padding: 1.5rem;
    box-shadow: 0 1px 2px rgba(26, 22, 20, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card-google--depois {
    background-color: var(--color-paper);
    border-color: var(--color-clay-light);
    box-shadow: 0 8px 32px -16px rgba(181, 86, 58, 0.25);
  }

  .card-google__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.85rem;
  }
  .card-google__brand {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink-soft);
    display: inline-flex;
    align-items: center;
  }
  .card-google__g {
    color: #4285F4;
    font-weight: 700;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    margin-right: 1px;
  }
  .card-google__chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .card-google__chip--bad {
    background: rgba(181, 86, 58, 0.1);
    color: var(--color-clay-deep);
    border: 1px solid rgba(181, 86, 58, 0.3);
  }

  /* Body do card */
  .card-google__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-google__photo {
    height: 140px;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }
  .card-google__photo--empty {
    background: repeating-linear-gradient(
      45deg,
      var(--color-cream-deep),
      var(--color-cream-deep) 10px,
      var(--color-cream) 10px,
      var(--color-cream) 20px
    );
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .card-google__photo--full {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 4px;
  }
  .ph {
    border-radius: 4px;
  }
  .ph--1 {
    grid-row: 1 / span 2;
    background:
      linear-gradient(135deg, #c87a5f 0%, #8B3E29 100%);
    position: relative;
    overflow: hidden;
  }
  .ph--1::before {
    content: "";
    position: absolute;
    inset: 30%;
    background: radial-gradient(circle, rgba(255, 240, 220, 0.5), transparent 70%);
  }
  .ph--2 {
    background: linear-gradient(135deg, #d9a89a 0%, #b5563a 100%);
  }
  .ph--4 {
    grid-column: 2;
    grid-row: 2;
    background: rgba(26, 22, 20, 0.85);
    color: var(--color-paper);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
  }
  /* No grid completo, ph--3 é célula 1,2 */
  .card-google__photo--full .ph--2 { grid-column: 2; grid-row: 1; }

  .card-google__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 36;
    margin-bottom: 0.4rem;
  }
  .card-google__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .stars {
    color: var(--color-gold);
    letter-spacing: 1px;
    font-size: 0.85rem;
  }
  .stars__off { color: rgba(26, 22, 20, 0.15); }
  .rating-num { font-weight: 600; color: var(--color-ink); font-family: var(--font-mono); }
  .rating-count { font-size: 0.8rem; }

  .card-google__row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--color-line);
  }
  .card-google__row:first-of-type { border-top: 0; padding-top: 0; }

  .card-google__row--bad { color: var(--color-ink-soft); text-decoration: line-through; text-decoration-color: rgba(181, 86, 58, 0.4); text-decoration-thickness: 1px; }
  .card-google__row--good { color: var(--color-ink); font-weight: 500; }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .dot--bad { background-color: var(--color-clay); }
  .dot--good { background-color: var(--color-moss); }

  /* "Depois" recebe um título visual sutil ANTES do card no mobile */
  @media (max-width: 767px) {
    .analise__grid > .card-google--depois::before {
      content: "Depois de 5 dias";
      display: block;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-clay);
      margin-bottom: -0.5rem;
    }
  }
</style>

<script>
  import { initReveal } from "../lib/motion.ts";
  initReveal();
</script>
